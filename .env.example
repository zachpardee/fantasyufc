# ─── Supabase ────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJ...          # "anon" public key
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # "service_role" secret key — never expose client-side

# ─── Database ────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → Database → Connection String → URI
# Use the "Session" mode (port 5432) for the API server.
# Supabase format: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Local Docker format: postgresql://postgres:password@localhost:5432/fantasy_ufc

DATABASE_URL=postgresql://postgres.your-ref:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ─── Redis ───────────────────────────────────────────────────────────────────
# Local Docker: redis://localhost:6379
# Redis Cloud / Upstash: rediss://default:password@host:port

REDIS_URL=redis://localhost:6379

# ─── API ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Dashboard → Project Settings → API → JWT Settings → JWT Secret
JWT_SECRET=your-supabase-jwt-secret

# ─── Admin ───────────────────────────────────────────────────────────────────
# Comma-separated Supabase user UUIDs that can access /admin/* routes.
# Sign up through the app first, then find your UUID in Dashboard → Auth → Users.
ADMIN_USER_IDS=uuid-one,uuid-two

# ─── Expo Push Notifications ─────────────────────────────────────────────────
# Create a project at expo.dev → Account Settings → Access Tokens
EXPO_ACCESS_TOKEN=your-expo-access-token
