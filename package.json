{
  "name": "fantasy-ufc",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "npm run migrate --workspace=apps/api",
    "db:seed": "npm run seed --workspace=apps/api",
    "setup": "npx tsx scripts/setup-supabase.ts",
    "setup:seed": "npx tsx scripts/setup-supabase.ts --seed",
    "deploy": "vercel --prod && railway up --detach"
  },
  "devDependencies": {
    "prettier": "3.8.4",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@sentry/node": "^10.57.0"
  }
}
